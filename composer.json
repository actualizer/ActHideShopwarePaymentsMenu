{
    "name": "actualizer/hide-shopware-payments-menu",
    "description": "Hides the Shopware Payments admin main menu entry and order detail tab",
    "version": "1.1.0",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Actualize",
            "email": "plugin@actualize.de",
            "homepage": "https://actualize.de",
            "role": "Developer"
        }
    ],
    "require": {
        "shopware/core": ">=6.7 <6.8",
        "php": ">=8.4"
    },
    "extra": {
        "shopware-plugin-class": "Act\\HideShopwarePaymentsMenu\\ActHideShopwarePaymentsMenu",
        "label": {
            "de-DE": "Actualize: Shopware-Payments-Einträge ausblenden",
            "en-GB": "Actualize: Hide Shopware Payments entries"
        },
        "description": {
            "de-DE": "Blendet die Shopware-Payments-Einträge im Admin aus: den Hauptmenü-Eintrag samt Untereinträgen und den Reiter in der Bestelldetailansicht. App und Zahlarten bleiben unangetastet.",
            "en-GB": "Hides the Shopware Payments entries from the admin: the main menu entry with its sub-entries and the tab in the order detail view. The app and its payment methods stay untouched."
        },
        "manufacturerLink": {
            "de-DE": "https://actualize.de",
            "en-GB": "https://actualize.de"
        },
        "supportLink": {
            "de-DE": "https://github.com/actualizer/ActHideShopwarePaymentsMenu/issues",
            "en-GB": "https://github.com/actualizer/ActHideShopwarePaymentsMenu/issues"
        }
    },
    "autoload": {
        "psr-4": {
            "Act\\HideShopwarePaymentsMenu\\": "src/"
        }
    },
    "scripts": {
        "format": "docker run --rm -v $(pwd):/ext shopware/shopware-cli:latest extension format /ext",
        "check": "docker run --rm -v $(pwd):/ext shopware/shopware-cli:latest extension validate --full /ext"
    }
}
